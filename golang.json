{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Dependency policy for Go projects.",
  "packageRules": [
    {
      "description": "golang.org/x modules release in lockstep",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["golang.org/x/**"],
      "groupName": "golang.org/x packages"
    }
  ]
}
